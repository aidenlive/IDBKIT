{
  "name": "idbkit",
  "version": "1.0.0",
  "description": "A typed, promise-based IndexedDB toolkit: schema migrations, queries, cursors, pagination, bulk writes, backup/restore — zero runtime dependencies.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "postbuild": "node scripts/copy-vendor.mjs",
    "dev": "tsup --watch",
    "clean": "rimraf dist coverage",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bench": "tsx benchmarks/run.ts",
    "site": "node scripts/copy-vendor.mjs && node scripts/serve-site.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "indexeddb",
    "idb",
    "database",
    "storage",
    "offline",
    "typescript",
    "promise",
    "migrations",
    "query",
    "cursor",
    "pagination",
    "browser",
    "client-side"
  ],
  "author": "idbkit contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/idbkit/idbkit.git"
  },
  "bugs": {
    "url": "https://github.com/idbkit/idbkit/issues"
  },
  "homepage": "https://github.com/idbkit/idbkit#readme",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "fake-indexeddb": "^6.0.0",
    "prettier": "^3.3.2",
    "rimraf": "^5.0.7",
    "tsup": "^8.1.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
